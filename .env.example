# ---------- Required ----------
# New Firebase project for A1 Socials (Firestore + service account)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# The WhatsApp number this bot will link to, international format, no + or spaces
# e.g. 2348012345678
BOT_PHONE_NUMBER=

# ---------- Recommended (features fail without these) ----------
# Owlet backend API
OWLET_API_KEY=
OWLET_BASE_URL=https://a1socials.mysocials.store/api/store-v2

# Flutterwave v4 — for wallet funding via dynamic virtual accounts (PWBT)
# Client ID / Client Secret are what the v4 dashboard shows in the slots
# labeled "Public Key" / "Secret Key" respectively.
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
# "production" once live; defaults to sandbox otherwise
FLW_ENV=sandbox
# Not required for PWBT (bank transfer) — only needed for direct card charges.
# Kept here for when/if card payments get added.
FLW_ENCRYPTION_KEY=
# Set in Flutterwave dashboard under Settings > Webhooks — used by
# netlify/functions/flw-v4-webhook.js to verify incoming webhooks.
# Only needed on whatever host runs the webhook (Netlify), not on Render.
FLW_WEBHOOK_SECRET_HASH=

# ---------- Optional ----------
LOG_LEVEL=info
PORT=3000
